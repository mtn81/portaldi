{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-before-commit.sh",
            "timeout": 600,
            "statusMessage": "Running make lint and make test-all before commit..."
          }
        ]
      }
    ]
  }
}
